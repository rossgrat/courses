\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{system/latex/curriculum}

\RequirePackage[letterpaper,left=0.65in,right=0.65in,top=0.7in,bottom=0.65in,headheight=14pt,headsep=13pt,footskip=20pt]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage[default,semibold]{sourcesans}
\RequirePackage{microtype}
\RequirePackage{array,enumitem,titlesec,titletoc,fancyhdr,ragged2e,multicol}
\RequirePackage[hyphens]{url}
\RequirePackage{hyperref}

\hypersetup{hidelinks,bookmarksopen=true}
\urlstyle{same}
\linespread{1.02}
\setlength{\parindent}{0pt}
\setlength{\parskip}{4pt}
\setlength{\emergencystretch}{2em}
\setlength{\tabcolsep}{6pt}
\setlength{\columnsep}{24pt}
\setlength{\multicolsep}{4pt}
\setlength{\premulticols}{0pt}
\renewcommand{\arraystretch}{1.2}
\clubpenalty=10000
\widowpenalty=10000
\raggedbottom

\setlist{leftmargin=1.2em,topsep=2pt,itemsep=0pt,parsep=0pt,partopsep=0pt}
\setlist[itemize]{label=\textbullet}
\newenvironment{topics}{\par\nopagebreak\noindent\begin{minipage}[b]{\linewidth}\RaggedRight\begin{multicols}{2}\begin{itemize}}{\end{itemize}\end{multicols}\end{minipage}\par}
\titleformat{\section}{\fontsize{18}{21}\selectfont\raggedright}{}{0pt}{}
\titlespacing*{\section}{0pt}{15pt}{7pt}
\titleformat{\subsection}{\normalsize\bfseries}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{9pt}{4pt}
\titleformat{\subsubsection}{\normalsize\itshape}{}{0pt}{}
\titlespacing*{\subsubsection}{0pt}{7pt}{3pt}
\titleformat{\paragraph}[runin]{\normalsize\bfseries}{}{0pt}{}[:]
\titlespacing*{\paragraph}{0pt}{7pt}{0.5em}
\newcommand{\prerequisites}[1]{{\small\itshape Prerequisites: #1.\par}\nopagebreak}

\setcounter{tocdepth}{1}
\titlecontents{section}[0pt]{\addvspace{4pt}\small}{}{}{\hfill\contentspage}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\footnotesize\coursename}
\fancyfoot[C]{\footnotesize\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyhead[L]{\footnotesize\coursename}\fancyfoot[C]{\footnotesize\thepage}}

\newcommand{\coursecover}[7]{%
  \thispagestyle{empty}
  \vspace*{0.7in}
  \begin{center}
  {\fontsize{30}{35}\selectfont #1\par}
  \vspace{16pt}
  {\large #2\par}
  \end{center}
  \vspace{48pt}
  \paragraph*{Primary path} #3\par
  \paragraph*{#4} #5\par
  \vspace{16pt}
  \paragraph*{Course philosophy}
  {\large\itshape #6\par}
  \vfill
  #7\par
  \vspace{20pt}
  \clearpage
}

\renewenvironment{quote}{%
  \begin{list}{}{\setlength{\leftmargin}{12pt}\setlength{\rightmargin}{12pt}\setlength{\topsep}{4pt}}
  \item\relax\itshape
}{%
  \end{list}
}
